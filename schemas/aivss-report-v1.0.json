{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owasp.org/aivss/schemas/aivss-report-v1.0.json",
  "title": "AIVSS v1.0 Assessment Report",
  "description": "Report format for the AIVSS v1.0 CVSS-compatible AI scoring model. Validated against the output of the aivss-calc reference implementation.",
  "type": "object",
  "required": [
    "aivss_version",
    "rubric_version",
    "finding_id",
    "risk_category",
    "vector",
    "cvss",
    "ai_profile",
    "scores",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "aivss_version": { "const": "1.0" },
    "finding_id": { "type": "string", "minLength": 1 },
    "rubric_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Version of the AI metric rubric and lookup generator. Pinned separately from aivss_version so a stored assessment cannot silently change meaning when the rubric is revised."
    },
    "risk_category": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "OWASP Top 10 for Agentic Applications 2026",
          "enum": [
            "ASI01", "ASI02", "ASI03", "ASI04", "ASI05",
            "ASI06", "ASI07", "ASI08", "ASI09", "ASI10"
          ]
        },
        "name": { "type": "string" }
      }
    },
    "vector": {
      "type": "string",
      "pattern": "^CVSS:4\\.0/",
      "description": "CVSS v4.0 vector extended with the optional AI metric group, per Appendix E section 8."
    },
    "cvss": {
      "type": "object",
      "required": ["vector", "macrovector", "cvss_bte"],
      "additionalProperties": false,
      "properties": {
        "vector": { "type": "string", "pattern": "^CVSS:4\\.0/" },
        "macrovector": { "type": "string", "pattern": "^[0-2]{6}$" },
        "cvss_bte": { "type": "number", "minimum": 0.0, "maximum": 10.0 }
      }
    },
    "ai_profile": {
      "type": "object",
      "required": ["present", "metrics", "vector_fragment", "effect_class"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "metrics": { "type": "object" },
        "vector_fragment": { "type": "string" },
        "effect_class": { "enum": ["A0", "A1", "A2"] }
      }
    },
    "scores": {
      "type": "object",
      "required": ["mode1_interpretation"],
      "additionalProperties": false,
      "properties": {
        "mode1_interpretation": {
          "type": "object",
          "required": ["aivss", "cvss_bte", "td_delta", "basis", "status"],
          "additionalProperties": false,
          "properties": {
            "aivss": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 10.0,
              "description": "Published AIVSS risk score: min(10, CVSS-BTE + TD_delta)."
            },
            "cvss_bte": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 10.0,
              "description": "Interpolated CVSS Base+Threat+Environmental score before TD adjustment."
            },
            "td_delta": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 0.5,
              "description": "Traceability Deficit risk adjustment (TD:H=0.5, TD:M=0.2, TD:L=0.0)."
            },
            "basis": { "type": "string" },
            "status": { "const": "normative" }
          }
        },
        "mode2_macrovector": {
          "type": "object",
          "required": [
            "aivss_btea",
            "btea_before_td",
            "promoted_macrovector",
            "macrovector_delta",
            "td_delta",
            "delta",
            "saturated",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "aivss_btea": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
            "btea_before_td": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
            "promoted_macrovector": { "type": "string", "pattern": "^[0-2]{6}$" },
            "macrovector_delta": { "type": "number", "minimum": 0.0 },
            "td_delta": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
            "delta": { "type": "number", "minimum": 0.0 },
            "saturated": { "type": "boolean" },
            "status": { "type": "string", "pattern": "^provisional" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "exploitation",
        "decision_points",
        "bod_2604_timeline",
        "bod_2604_label",
        "aivss_recommended_timeline",
        "aivss_recommended_label",
        "escalated",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "exploitation": {
          "type": "object",
          "required": ["rung", "rationale", "state", "authoritative"],
          "additionalProperties": false,
          "properties": {
            "rung": {
              "enum": ["cisa_kev", "vulnrichment_active", "observed_local", "poc", "none"]
            },
            "rationale": { "type": "string" },
            "state": { "enum": ["active", "active_unverified", "poc", "none"] },
            "authoritative": { "type": "boolean" },
            "epss": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "epss_date": {
              "type": ["string", "null"],
              "description": "ISO 8601 date. Mandatory whenever epss is non-null: EPSS is revised daily and an undated score is not reproducible."
            }
          },
          "allOf": [
            {
              "if": { "properties": { "epss": { "type": "number" } }, "required": ["epss"] },
              "then": { "properties": { "epss_date": { "type": "string", "minLength": 1 } }, "required": ["epss_date"] }
            }
          ]
        },
        "decision_points": {
          "type": "object",
          "required": [
            "in_kev",
            "publicly_exposed",
            "automatable",
            "automatable_source",
            "technical_impact",
            "technical_impact_source",
            "ai_effect_class"
          ],
          "additionalProperties": false,
          "properties": {
            "in_kev": { "type": "boolean" },
            "publicly_exposed": { "type": "boolean" },
            "automatable": { "type": "boolean" },
            "automatable_source": { "type": "string" },
            "technical_impact": { "enum": ["partial", "total"] },
            "technical_impact_source": { "type": "string" },
            "ai_effect_class": { "enum": ["A0", "A1", "A2"] },
            "td": { "enum": ["H", "M", "L"] }
          }
        },
        "bod_2604_timeline": { "$ref": "#/$defs/timeline" },
        "bod_2604_label": { "type": "string" },
        "aivss_recommended_timeline": { "$ref": "#/$defs/timeline" },
        "aivss_recommended_label": { "type": "string" },
        "escalated": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "priority": {
      "type": "object",
      "description": "Level 3 only. Organization-internal; MUST NOT be published outside the assessing organization or compared across organizations.",
      "required": ["aivss_p", "band", "terms", "scope"],
      "additionalProperties": false,
      "properties": {
        "aivss_p": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["Immediate", "This sprint", "Scheduled", "Backlog"] },
        "terms": {
          "type": "object",
          "required": ["severity_norm", "business_criticality", "reach", "likelihood"],
          "additionalProperties": false,
          "properties": {
            "severity_norm": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "business_criticality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "reach": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "likelihood": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "scope": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["assessor_kind"],
      "additionalProperties": false,
      "properties": {
        "assessor": { "type": ["string", "null"] },
        "assessor_kind": { "enum": ["human", "scanner", "llm_assisted", "imported"] },
        "tool": { "type": ["string", "null"] },
        "tool_version": { "type": ["string", "null"] },
        "assessed_at": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "timeline": {
      "enum": ["FSU", "60D", "14D", "3D", "3DF"],
      "description": "CISA BOD 26-04 Table 1 remediation timeline key."
    }
  }
}
